# ==============================================================================
# CLINIQ — ENVIRONMENT CONFIGURATION (.env.example)
# Healthcare & Dental Provider Discovery and Appointment Platform
# ==============================================================================

# AI SEARCH ASSISTANT (Optional for basic search, required for Gemini AI Natural Language Search)
# AI Studio automatically injects this at runtime from secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted
APP_URL="http://localhost:3000"

# ==============================================================================
# OPTIONAL MOBILITY & MAPPING INTEGRATION (Production Mode)
# ==============================================================================
# By default, Cliniq runs in DEMO / LOCAL HEURISTIC MODE with ZERO external API keys.
# Walking, driving, and transit calculations run 100% locally using urban road
# topology heuristics, nearest station data, and Google Maps deep links.
#
# To connect Google Maps Platform live API:
# 1. Enable Distance Matrix API & Places API in Google Cloud Console
# 2. Supply your API Key:
VITE_GOOGLE_MAPS_API_KEY=""

# ==============================================================================
# OPTIONAL BACKEND API INTEGRATIONS (Production Mode)
# ==============================================================================
# When connecting to a custom backend / microservices (see ARCHITECTURE.md & INTEGRATIONS.md):
# VITE_API_BASE_URL="https://api.yourdomain.com/v1"
# VITE_WHATSAPP_PHONE_NUMBER_ID=""
# VITE_WHATSAPP_ACCESS_TOKEN=""
